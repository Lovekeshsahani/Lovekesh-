# Database
DATABASE_URL=postgresql://user:password@localhost:5432/gana_bajao
DB_HOST=localhost
DB_PORT=5432
DB_USER=gana_bajao_user
DB_PASSWORD=secure_password_here
DB_NAME=gana_bajao

# Server
PORT=3000
NODE_ENV=development

# Authentication
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRE=7d
REFRESH_TOKEN_EXPIRE=30d

# Music Providers
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
APPLE_MUSIC_TOKEN=your_apple_music_token
YOUTUBE_MUSIC_API_KEY=your_youtube_music_api_key

# Admin
ADMIN_EMAIL=admin@ganabajao.com
ADMIN_PASSWORD=admin_password_hash

# Storage (for offline downloads)
STORAGE_PATH=./uploads/downloads
MAX_DOWNLOAD_SIZE_MB=500

# Ads
AD_PROVIDER=google_ad_manager
AD_PROVIDER_KEY=your_ad_provider_key

# Session & Security
CORS_ORIGIN=http://localhost:5173
RATION_LIMIT_WINDOW_MS=900000
RATION_LIMIT_MAX_REQUESTS=100
